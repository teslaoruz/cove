import { Theme, Icons } from "theme.slint";

export struct ProjectItem {
    idx: int,
    name: string,
    initials: string,
    hue: int,
    icon: image,
    has-icon: bool,
    meta: string,
    state: string,   // "" | working | waiting | idle | running
    slot: int,       // Alt+slot opens it; 0 = none
    pinned: bool,
}

export struct AgentItem {
    idx: int,
    name: string,
    initials: string,
    hue: int,
    icon: image,
    has-icon: bool,
    tool: string,
    state: string,
    wid: string,     // compositor window id, "" = none
}

export component Icon {
    in property <string> d;
    in property <color> color: Theme.soft;
    in property <length> size: 18px;
    in property <length> weight: 1.7px;
    width: size;
    height: size;
    Path {
        width: parent.width;
        height: parent.height;
        commands: root.d;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.color;
        stroke-width: root.weight;
        stroke-line-cap: round;
        fill: transparent;
    }
}

// A glass panel: one tint, one hairline, one top highlight, a soft shadow.
export component Panel inherits Rectangle {
    in property <length> pad: 16px;
    background: Theme.panel;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.hair;
    drop-shadow-blur: 22px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: Theme.shadow;
    Rectangle {
        x: 14px;
        y: 1px;
        width: parent.width - 28px;
        height: 1px;
        background: Theme.top;
    }
    @children
}

export component Squircle inherits Rectangle {
    in property <int> hue;
    in property <string> initials;
    in property <image> icon;
    in property <bool> has-icon;
    in property <length> size: 40px;
    width: size;
    height: size;
    border-radius: size * 0.26;
    background: has-icon ? #1c1c20 : @linear-gradient(180deg, Theme.hue-top(hue) 0%, Theme.hue-bottom(hue) 100%);
    drop-shadow-blur: 3px;
    drop-shadow-offset-y: 1px;
    drop-shadow-color: rgba(0, 0, 0, 0.20);
    clip: true;
    if !has-icon: Text {
        text: root.initials;
        color: white;
        font-size: root.size * 0.36;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if has-icon: Image {
        x: 3px;
        y: 3px;
        width: parent.width - 6px;
        height: parent.height - 6px;
        source: root.icon;
        image-fit: contain;
    }
    // top light of the fill
    Rectangle {
        x: root.size * 0.18;
        y: 0.5px;
        width: root.size * 0.64;
        height: 1px;
        background: rgba(255, 255, 255, 0.40);
    }
}

// The live mark: a comet with a fading tail that circles the project while its agent works,
// a slow amber pulse while it waits for you, a still grey dot when idle.
// Live mark around a project icon: a bright line runs around its rounded square while the agent works;
// a steady amber outline that gently breathes while it waits for you. One brush, no per-dot elements.
export component Orbit inherits Rectangle {
    in property <string> state;
    in property <length> size: 40px;
    property <float> p: Theme.phase;
    property <length> gap: 3px;
    width: size + 2 * gap;
    height: size + 2 * gap;
    if state == "working": Rectangle {
        border-radius: root.size * 0.26 + root.gap;
        border-width: 2px;
        border-color: @conic-gradient(from root.p * 0.6turn, Theme.live.with-alpha(0) 0deg, Theme.live.with-alpha(0) 200deg, Theme.live.with-alpha(0.55) 300deg, Theme.live 352deg, #ffffff 360deg);
    }
    if state == "working": Rectangle {   // faint full track under the moving line
        border-radius: root.size * 0.26 + root.gap;
        border-width: 1px;
        border-color: Theme.live.with-alpha(0.14);
    }
    if state == "waiting": Rectangle {
        border-radius: root.size * 0.26 + root.gap;
        border-width: 2px;
        border-color: Theme.warm.with-alpha(0.45 + 0.4 * (0.5 + 0.5 * Math.sin(root.p * 0.65turn)));
    }
}

export component Btn inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary;
    in property <bool> quiet;
    in property <string> tip;
    callback clicked;
    property <bool> hot: ta.has-hover || fs.has-focus;
    out property <bool> hovered: hot;
    height: 34px;
    width: lay.preferred-width; // buttons hug their content, in a layout or not
    border-radius: 9px;
    background: primary ? (ta.pressed ? Theme.accent.darker(10%) : hot ? Theme.accent.brighter(8%) : Theme.accent) : quiet ? (hot ? Theme.panel : transparent) : (hot ? Theme.panel-hi : Theme.panel);
    border-width: primary || quiet ? 0 : 1px;
    border-color: Theme.hair;
    animate background { duration: 100ms; }
    accessible-role: button;
    accessible-label: text != "" ? text : tip;
    accessible-action-default => { root.clicked(); }
    fs := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " { root.clicked(); return accept; }
            reject
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
    lay := HorizontalLayout {
        padding-left: text == "" ? 8px : 14px;
        padding-right: text == "" ? 8px : 14px;
        spacing: 7px;
        alignment: center;
        if icon != "": Icon {
            y: (parent.height - self.height) / 2;
            d: root.icon;
            size: 17px;
            color: root.primary ? Theme.on-accent : Theme.ink;
        }
        if text != "": Text {
            text: root.text;
            color: root.primary ? Theme.on-accent : Theme.ink;
            font-size: Theme.t-body;
            font-weight: root.primary ? 650 : 500;
            vertical-alignment: center;
        }
    }
    Rectangle {
        visible: fs.has-focus;
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: 11px;
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
    }
}

export component Tile inherits Rectangle {
    in property <ProjectItem> item;
    callback open(int);
    callback details(int);
    callback cont(int);
    callback menu(ProjectItem, length, length);
    property <bool> hot: ta.has-hover || fs.has-focus;
    property <bool> has-sessions: item.meta != "No sessions yet";
    height: 66px;
    border-radius: 14px;
    background: hot ? Theme.panel-hi : Theme.panel;
    border-width: 1px;
    border-color: fs.has-focus ? Theme.accent : Theme.hair;
    animate background { duration: 100ms; }
    accessible-role: button;
    accessible-label: item.name + ", " + item.meta;
    accessible-action-default => { root.details(item.idx); }
    fs := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Return { root.details(root.item.idx); return accept; }
            if e.text == Key.Menu || (e.text == Key.F10 && e.modifiers.shift) { root.menu(root.item, root.absolute-position.x + root.width - 200px, root.absolute-position.y + 40px); return accept; }
            reject
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.details(root.item.idx); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                root.menu(root.item, root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
            }
        }
    }
    Rectangle {
        x: 14px; y: 1px; width: parent.width - 28px; height: 1px; background: Theme.top;
    }
    HorizontalLayout {
        padding: 12px;
        padding-right: 8px;
        spacing: 11px;
        Squircle {
            hue: root.item.hue;
            initials: root.item.initials;
            icon: root.item.icon;
            has-icon: root.item.has-icon;
            size: 40px;
            y: (parent.height - self.height) / 2;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 4px;
                Text {
                    text: root.item.name;
                    color: Theme.ink;
                    font-size: Theme.t-body;
                    font-weight: 650;
                    overflow: elide;
                }
                if root.item.pinned: Icon { d: Icons.pin; size: 13px; weight: 1.6px; color: Theme.faint; y: (parent.height - self.height) / 2; }
            }
            HorizontalLayout {
                spacing: 6px;
                if root.item.state != "": Rectangle {
                    y: (parent.height - 7px) / 2;
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: root.item.state == "waiting" ? Theme.warm : root.item.state == "idle" ? Theme.faint : Theme.live;
                }
                Text {
                    text: root.item.state == "working" ? "Working" : root.item.state == "waiting" ? "Needs you" : root.item.meta;
                    color: root.item.state == "working" ? Theme.live : root.item.state == "waiting" ? Theme.warm : Theme.soft;
                    font-size: Theme.t-small;
                    font-weight: root.item.state == "working" || root.item.state == "waiting" ? 600 : 400;
                    overflow: elide;
                }
            }
        }
        if root.has-sessions: Rectangle {
            y: (parent.height - 30px) / 2;
            width: 30px;
            height: 30px;
            border-radius: 15px;
            background: cta.has-hover ? Theme.accent : Theme.accent.with-alpha(root.hot ? 0.18 : 0.12);
            animate background { duration: 100ms; }
            accessible-role: button;
            accessible-label: "Continue " + root.item.name;
            accessible-action-default => { root.cont(root.item.idx); }
            Icon { x: 9.5px; d: Icons.play; size: 12px; weight: 1.6px; color: cta.has-hover ? Theme.on-accent : Theme.accent-text; }
            cta := TouchArea { mouse-cursor: pointer; clicked => { root.cont(root.item.idx); } }
        }
        Rectangle {
            y: (parent.height - 30px) / 2;
            width: 26px;
            height: 30px;
            border-radius: 7px;
            background: mta.has-hover ? Theme.panel : transparent;
            Icon { d: Icons.more; size: 16px; weight: 2.6px; color: mta.has-hover ? Theme.ink : Theme.faint; }
            mta := TouchArea {
                clicked => { root.menu(root.item, root.absolute-position.x + root.width - 200px, root.absolute-position.y + 34px); }
                mouse-cursor: pointer;
            }
        }
    }
}

// Tiles in as many equal columns as fit; the last row fills from the left.
export component TileGrid inherits Rectangle {
    in property <[ProjectItem]> items;
    in property <length> min-tile: 220px;
    callback open(int);
    callback details(int);
    callback cont(int);
    callback menu(ProjectItem, length, length);
    property <length> gap: 10px;
    property <int> cols: Math.max(1, Math.floor((self.width + gap) / (min-tile + gap)));
    property <length> cell: (self.width - (cols - 1) * gap) / cols;
    height: items.length == 0 ? 0 : Math.ceil(items.length / cols) * (66px + gap) - gap;
    for it[i] in items: Tile {
        x: Math.mod(i, root.cols) * (root.cell + root.gap);
        y: Math.floor(i / root.cols) * (66px + root.gap);
        width: root.cell;
        item: it;
        open(n) => { root.open(n); }
        details(n) => { root.details(n); }
        cont(n) => { root.cont(n); }
        menu(n, x, y) => { root.menu(n, x, y); }
    }
}

export component SectionHead inherits HorizontalLayout {
    in property <string> text;
    in property <string> link;
    callback link-clicked;
    padding-top: 10px;
    Text {
        text: root.text;
        color: Theme.ink;
        font-size: Theme.t-lead;
        font-weight: 700;
        horizontal-stretch: 1;
    }
    if link != "": Text {
        text: root.link;
        color: Theme.accent-text;
        font-size: Theme.t-body;
        lta := TouchArea {
            clicked => { root.link-clicked(); }
            mouse-cursor: pointer;
        }
    }
}

export component ListRow inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <int> hue: -1;
    in property <string> initials;
    in property <bool> selected;   // picked with the arrow keys from the search bar
    callback clicked;
    min-height: 50px;
    border-radius: 10px;
    background: ta.has-hover || fs.has-focus || selected ? Theme.panel-hi : Theme.panel;
    border-width: 1px;
    border-color: fs.has-focus || selected ? Theme.accent : Theme.hair;
    accessible-role: button;
    accessible-label: title;
    accessible-action-default => { root.clicked(); }
    fs := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Return { root.clicked(); return accept; }
            reject
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
    HorizontalLayout {
        padding: 10px;
        padding-left: 14px;
        spacing: 12px;
        if hue >= 0: Squircle { hue: root.hue; initials: root.initials; size: 30px; y: (parent.height - self.height) / 2; }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: root.title; color: Theme.ink; font-size: Theme.t-body; font-weight: 600; overflow: elide; }
            if sub != "": Text { text: root.sub; color: Theme.soft; font-size: Theme.t-small; overflow: elide; }
        }
    }
}
