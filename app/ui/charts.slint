// Static charts for the Activity page. Nothing animates; one TouchArea per chart reads the hovered cell.
import { Theme } from "theme.slint";
import { Panel } from "parts.slint";

export struct Month { col: int, text: string }
export struct Heat { levels: [int], tips: [string], months: [Month], idle: string }
export struct Bar { label: string, value: float, tip: string, hue: int, idx: int }

export component ChartCard inherits Panel {
    in property <string> title;
    in property <string> sub;
    VerticalLayout {
        padding: 16px;
        padding-top: 14px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 10px;
            Text { text: root.title; color: Theme.ink; font-size: Theme.t-lead; font-weight: 700; horizontal-stretch: 1; overflow: elide; }
            Text { text: root.sub; color: Theme.faint; font-size: Theme.t-small; vertical-alignment: center; }
        }
        @children
    }
}

// Contribution grid: `cols` columns of 7 rows, column-major. Level -1 = not yet (future day).
export component Heatmap inherits VerticalLayout {
    in property <Heat> data;
    in property <int> cols: 53;
    in property <[string]> row-labels: ["", "Mon", "", "Wed", "", "Fri", ""];
    in property <color> tint: Theme.accent;
    in property <length> max-cell: 19px;
    property <length> gap: 3px;
    property <length> label-w: 32px;
    property <length> cell: Math.max(5px, Math.min(max-cell, (self.width - label-w) / cols - gap));
    property <length> step: cell + gap;
    property <length> ox: Math.max(0px, (self.width - label-w - cols * step + gap) / 2); // centre the grid when cells hit max-cell
    property <int> hover: ta.has-hover ? Math.floor(ta.mouse-x / step) * 7 + Math.floor(ta.mouse-y / step) : -1;
    property <bool> on-cell: hover >= 0 && hover < data.levels.length && data.levels[hover] >= 0;
    spacing: 6px;
    Rectangle {
        height: 14px;
        for m in data.months: Text { x: ox + label-w + m.col * step; y: 0; text: m.text; color: Theme.faint; font-size: 11px; }
    }
    Rectangle {
        height: 7 * step - gap;
        for l[i] in row-labels: Text { x: ox; y: i * step + (cell - self.preferred-height) / 2; text: l; color: Theme.faint; font-size: 11px; }
        for v[i] in data.levels: Rectangle {
            x: ox + label-w + Math.floor(i / 7) * step;
            y: Math.mod(i, 7) * step;
            width: cell;
            height: cell;
            border-radius: Math.min(3px, cell / 4);
            background: v < 0 ? transparent : v == 0 ? Theme.cell-empty : tint.with-alpha([0, 0.30, 0.52, 0.76, 1.0][v]);
            border-width: i == root.hover && v >= 0 ? 1.5px : 0;
            border-color: Theme.ink;
        }
        ta := TouchArea { x: ox + label-w; width: cols * step; }
    }
    HorizontalLayout {
        spacing: 4px;
        // readout sits in a plain Rectangle so its text never feeds back into the layout width
        Rectangle {
            horizontal-stretch: 1;
            Text { x: 0; width: parent.width; text: on-cell ? data.tips[hover] : data.idle; color: on-cell ? Theme.ink : Theme.faint; font-size: Theme.t-small; overflow: elide; vertical-alignment: center; }
        }
        Text { text: "Less"; color: Theme.faint; font-size: 11px; vertical-alignment: center; }
        for k in 5: VerticalLayout {
            alignment: center;
            Rectangle { width: 10px; height: 10px; border-radius: 2.5px; background: k == 0 ? Theme.cell-empty : root.tint.with-alpha([0, 0.30, 0.52, 0.76, 1.0][k]); }
        }
        Text { text: "More"; color: Theme.faint; font-size: 11px; vertical-alignment: center; }
    }
}

// Vertical bars over a baseline, value 0..1. Labels print only where `label` is set.
export component Columns inherits VerticalLayout {
    in property <[Bar]> bars;
    in property <color> tint: Theme.accent;
    in property <length> chart-h: 96px;
    in property <string> idle;
    property <length> slot: self.width / Math.max(1, bars.length);
    property <int> hover: ta.has-hover ? Math.floor(ta.mouse-x / slot) : -1;
    property <bool> on-bar: hover >= 0 && hover < bars.length;
    spacing: 6px;
    Rectangle {
        height: chart-h;
        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.hair; }
        for b[i] in bars: Rectangle {
            x: i * slot + slot * 0.16;
            width: slot * 0.68;
            height: b.value > 0 ? Math.max(2px, (parent.height - 2px) * b.value) : 0px;
            y: parent.height - 1px - self.height;
            border-radius: Math.min(3px, self.width / 3);
            background: i == root.hover ? root.tint : root.tint.with-alpha(0.7);
        }
        ta := TouchArea { }
    }
    Rectangle {
        height: 13px;
        for b[i] in bars: Text { x: i * slot + (slot - self.preferred-width) / 2; y: 0; text: b.label; color: Theme.faint; font-size: 11px; }
    }
    Rectangle {
        height: 16px;
        Text { x: 0; width: parent.width; text: on-bar ? bars[hover].tip : idle; color: on-bar ? Theme.ink : Theme.faint; font-size: Theme.t-small; overflow: elide; }
    }
}

// Ranked horizontal bars, one row per item, coloured by the item's hue.
export component HBars inherits VerticalLayout {
    in property <[Bar]> bars;
    callback clicked(int);
    spacing: 2px;
    for b in bars: Rectangle {
        height: 30px;
        border-radius: 7px;
        background: ta.has-hover ? Theme.panel : transparent;
        ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(b.idx); } }
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 12px;
            Text { text: b.label; width: 132px; color: Theme.ink; font-size: Theme.t-body; overflow: elide; vertical-alignment: center; }
            Rectangle {
                horizontal-stretch: 1;
                Rectangle {
                    x: 0;
                    y: (parent.height - 8px) / 2;
                    width: Math.max(4px, parent.width * b.value);
                    height: 8px;
                    border-radius: 4px;
                    background: @linear-gradient(90deg, Theme.hue-bottom(b.hue) 0%, Theme.hue-top(b.hue) 100%);
                }
            }
            Text { text: b.tip; width: 170px; color: Theme.soft; font-size: Theme.t-small; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
        }
    }
}
